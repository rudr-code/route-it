# Route.it Environment Variables Example
# Copy to .env for local configuration

# Unified server port (Render injects $PORT automatically)
PORT=8001

# Python runtime configuration
PYTHONUNBUFFERED=1

# SQLite storage directory (e.g. /app/data in Docker or Render disk)
DATA_DIR=data

# Security Secrets (Override in production deployments)
ROUTEIT_SECRET_KEY=change-this-to-a-secure-random-secret-key
ROUTEIT_OTP_SECRET=change-this-to-a-secure-otp-hmac-secret-key

# Optional Valhalla offline road-network routing URL (fallback: internal Euclidean)
# VALHALLA_URL=http://localhost:8002
